###################################
######## Lepton requirement #######
###################################

######## Muon requirement   #######
Muon_ID : "Tight"
MuonPt_cut : 20.0
MuonEta_cut : 2.4
MuonIso_type : "PFIsodbeta04"
MuonIso_cut  : 0.15

######## Elecrtron requirement ######
Elec_ID      : "SCBTight"
ElecPt_cut      : 20.0
ElecEta_cut     : 2.4
ElecIso_type : "PFIsoRho03"
ElecIso_cut  : 0.0821



####### Jet requirement #######
Jet_pt : 30.0
Jet_eta : 2.4
#Jet_ID : "PFLoose"
Jet_ID : "PFTight"
#Jet_btag : "pfCSVV2M"
#Jet_btag : "deepJetM"
Jet_btag : "UParTM" ## switched from DeepJet to UParT (Unified Particle Transformer), Medium WP - matches UL2017/UL2018
# BTagDiscCut is no longer required for UParT* - SSBCorrections looks the cut
# up automatically from btagging.json.gz's "UParTAK4_wp_values" correction,
# keyed off Jet_btag's own WP letter ("M" here). NOT separately confirmed
# against the CMS BTV working-points table for 2016preVFP - verify the
# looked-up value in the job log against BTV's 2016preVFP UL UParTAK4 table.
BTagSFType : "comb" # mujets, comb - "comb" is the only SF UParTAK4 provides (was "mujets" for the old deepJetM WP)
################## CSVL , CSVM , CSMT #################

# PUIDWorkingPoint/PUIDSFSys/ApplyPUID/PUIDPtThreshold: inert for v15 Puppi
# jets - Jet_puId doesn't exist in v15 NanoAOD (Puppi jets don't need PU-jet-ID),
# and Analysis::PassPileupID() auto-no-ops when
# branchReader_.JetPuIdAvailable() is false. Left here (harmless) rather than deleted.
PUIDWorkingPoint : "L"
PUIDSFSys : "nom"
ApplyPUID : "true"
PUIDPtThreshold : 50
####### MET requirement #######
MET_cut : 40.0

####### MET Algoritm #######
METtype : "Puppi" ## PF or Puppi
applyMETXY : "False" ## "False" or "True"

####### Rochester Correction #######
applyRochester : "True"  ## "False" or "True"
applyElecSS : "True"  ## "False" or "True": EGM electron scale (data) / smearing (MC); MC smearing is deterministic per (run,lumi,event,iele)
ElecSSPath : "EGM/Run2-2016preVFP-UL-NanoAODv15/latest/electronSS_EtDependent.json.gz"
ElecScaleName : "Scale"
ElecSmearName : "SmearAndSyst"
ElecSSSys : "nominal"

####### Veto Muon & Electron Cleaning requirement #######

### case of Muon ###
VetoMuonPt : 20.0
VetoMuonEta : 2.4
VetoMuonId : "Loose"
VetoMuonIso : "PFIsodbeta04"
VetoMuonIsocut : 0.25

### case of Electron ###
VetoElecPt : 20.0
VetoElecEta : 2.4
VetoElecId : "SCBVeto"
VetoElecIdcut : {0.0, 1.0} # Not used...
VetoElecIso : "PFIsoRho03"
VetoElecIsocut : 0.175


### Lepton Scale Factor ###
MuonIDFile : "MuonIDEfficienciesAndSF_BCDEF.root"
MuonIDFiles : {"MuonIDEfficienciesAndSF_BCDEF.root","MuonIDEfficienciesAndSF_GH.root"}
MuonIsoFile : "MuonIsoEfficienciesAndSF_BCDEF.root"
TrackEffFile : "Tracking_EfficienciesAndSF_BCDEFGH.root"
MuonIsoFiles : {"MuonIsoEfficienciesAndSF_BCDEF.root","MuonIsoEfficienciesAndSF_GH.root"}
ElectronIDFile : "Electron_CutBased_Medium.root"
ElectronRecoFile : "Electron_RecoSF.root"

### Lepton Scale Factor ###
#TrigSFFile : "TriggerSFDiMuon.root"
#TrigSFFile : "triggerSummary_emu.root"
TrigSFFile : "TriggerSF_2016preVFP_ULv2.root"
TrigSFHist : "h2D_SF_emu_lepABpt_FullError" ## h2D_SF_mumu_lepABpt_FullError dimuon h2D_SF_ee_lepABpt_FullError dielec,  h2D_SF_emu_lepABpt_FullError muel

### BTagging Scale Factor csv file ###
BTaggingCSVFile : "UL2016preVFP/wp_deepCSV.csv"
BTaggingCSVFiles : {"UL2016preVFP/wp_deepCSV.csv"}

### Do JES ??
DoJES : "true"
#DoJES : "false"

### Do JER ??
DoJER : "true"
#DoJER : "false"
### Corrections & SFs with correctionlib ###
PileupSys : "nominal"
L1PreFireSys : "central" ## central ,up,down, none
TrigSFSys : "nominal"
