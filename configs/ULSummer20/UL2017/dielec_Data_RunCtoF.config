####### Blinding #######
isBlind : "True" ### after unblinding False
######## Decay Mode #######
Channel: "dielec"

######## Total Number of Event for Each Sample ######
UsingTotalEvent : "True"
########### false or true #######

XSecTablesName : "2017.txt"
