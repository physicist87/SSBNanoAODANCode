DoJER : "true"
#DoJER : "false"
### Corrections & SFs with correctionlib ###
PileupSys : "nominal"
L1PreFireSys : "central" ## central ,up,down, none
TrigSFSys : "nominal"
## JSon Path ##
PUWeightPath : "LUM/Run2-2017-UL-NanoAODv9/latest/puWeights.json.gz"
JERSFPath : "JME/Run2-2017-UL-NanoAODv15/latest/jet_jerc.json.gz"
JECPath : "JME/Run2-2017-UL-NanoAODv15/latest/jet_jerc.json.gz"
# CMS JME's official "JERSmear" correctionlib tool - SmearJER() uses this
# instead of an in-house TRandom3 implementation when set (see
# SSBCorrections.cpp). Matches UL2018's config: the path below was NOT
# confirmed to exist on cvmfs for 2018 either (code falls back to in-house
# TRandom3 smearing if the file isn't found) - same caveat applies here.
JERSmearPath : "JME/JER-Smearing/latest/jer_smear.json.gz"
JERSmearName : "JERSmear"
#JESName : "Summer19UL16_V7_MC_L1L2L3Res_AK4PFchs" ## dead key, not read anywhere in SSBCorrections.cpp - left commented out (also: wrong year, was UL16 - see UL2018 config)
JERPath : "JME/Run2-2017-UL-NanoAODv15/latest/jet_jerc.json.gz"

#JECName : "Summer19UL17_V5_MC_L1L2L3Res_AK4PFchs" ## 
JECName : "Summer20UL17NanoV15_V1" ## CONFIRMED from your jet_jerc.json.gz (78 corrections, 2 compound):
## compound "Summer20UL17NanoV15_V1_MC_L1L2L3Res_AK4PFPuppi" (inputs: JetA, JetEta, JetPt, Rho) and
## "..._V1_DATA_L1L2L3Res_AK4PFPuppi" (same + run) - exactly matches what ExpandJECName builds with
## JECName+JetAlgoTag+JECLevel below. No longer a guess.
#JECNameOld : "Summer19UL17_V5" ## 
JERName : "Summer19UL17_JRV4_MC_ScaleFactor_AK4PFPuppi" ## JER Sf name 

### BTagging Scale Factor csv file ###
BTaggingCSVFile : "UL2017/wp_deepCSV.csv"
BTaggingCSVFiles : {"UL2017/wp_deepCSV.csv"}

