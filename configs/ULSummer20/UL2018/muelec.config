######## Muon requirement   #######
Muon_ID : "Tight"
MuonPt_cut : 20.0
MuonEta_cut : 2.4
MuonIso_type : "PFIsodbeta04"
MuonIso_cut  : 0.15

######## Elecrtron requirement ######
Elec_ID      : "SCBTight"
ElecPt_cut      : 20.0
ElecEta_cut     : 2.4
ElecIso_type : "PFIsoRho03"
ElecIso_cut  : 0.0821



####### Jet requirement #######
Jet_pt : 30.0
Jet_eta : 2.4
#Jet_ID : "PFLoose"
Jet_ID : "PFTight"
#Jet_btag : "pfCSVV2M"
#Jet_btag : "deepJetM"
Jet_btag : "UParTM" ## switched from DeepJet to UParT (Unified Particle Transformer), Medium WP
# BTagDiscCut is no longer required for UParT* - SSBCorrections now looks the
# cut up automatically from btagging.json.gz's "UParTAK4_wp_values"
# correction, keyed off Jet_btag's own WP letter ("M" here), so "UParTM"
# alone is enough (see GetBtagWPCut() in SSBCorrections.cpp). Left commented
# out below as a manual override - if set, it takes priority over the
# auto-lookup (e.g. if BTV revises the calibration and the json isn't
# updated yet, or you want to test a non-standard cut). 0.1610 was the
# confirmed value from the CMS BTV working-points table you shared
# (Tagger=UParTAK4, WP=M, b eff ~83-85%) at the time this was written.
#BTagDiscCut : 0.1610
BTagSFType : "comb" # mujets, comb - set to "comb" since that's the only SF UParTAK4 actually
# provides (see the note below - BTagSFType is a no-op for UParT*, this value only matters
# if you ever switch Jet_btag back to deepJet/deepCSV, which DO have a mujets variant).
# Was "mujets" (correct for DeepJet - BTV's ttbar-dilepton bias-avoidance recommendation)
# but that's misleading left as-is for UParT, which silently ignores it anyway - changed
# to the value that's actually being used, so this line doesn't imply a choice that isn't
# happening.
# IMPORTANT: confirmed directly from your btagging.json.gz - for UParTAK4
# there is only ONE heavy-flavor SF, named "UParTAK4_comb" (no "..._mujets"
# variant exists for this tagger at all). BTagSFType above is therefore
# IGNORED when Jet_btag is UParT* (the code prints an [INFO] saying so) -
# it's only meaningful for DeepJet/DeepCSV. The tagger itself flags this
# explicitly in its own json description: "Should not be used by ttbar
# measurements with large overlap of SF derivation phase spaces (emu, >=2j
# and e/mu ==4j)" - i.e. CMS BTV is warning that 'comb' may not be
# statistically independent from dilepton ttbar selections like this
# dimuon/dielec/muelec analysis (this muelec/emu channel is EXACTLY the case
# named in that warning). Worth reading the full uncertainty-scheme section
# of the json description before using UParTAK4_comb for this specific
# channel - there may not be a better alternative yet, but it's a real
# caveat from BTV, not just a technical detail.
#BTagTaggerName : "UParTAK4_comb" ## confirmed correct name; override only if you want a different one
################## CSVL , CSVM , CSMT #################

PUIDWorkingPoint : "L"
PUIDSFSys : "nom"
ApplyPUID : "true"
PUIDPtThreshold : 50 
