## JSon Path ##
# Paths updated to the new CMS CAT cvmfs campaign-folder layout
# (/cvmfs/cms-griddata.cern.ch/cat/metadata/<POG>/<campaign>/latest/<file>).
# IMPORTANT: the campaign-folder naming is NOT uniform across POGs - your own
# `ls LUM/Run*` listing showed LUM keeps "Run2-2018-UL-NanoAODv9" even for a
# v15 analysis (pileup profiles don't depend on the NanoAOD tuple/jet format,
# so LUM never needed a new folder), while JME needed a new
# "Run2-2018-UL-NanoAODv15" folder specifically because AK4 jets moved to
# Puppi. So: JME/BTV below use the *v15* folder (BTV is a guess - UParT is
# new content, so BTV plausibly needed a new folder too, but this isn't
# confirmed the way JME and LUM are); LUM/MUO/EGM use the *v9* folder,
# reasoning that muon/electron reconstruction and pileup profiles are
# unrelated to the Jet collection change. Verify with your own `ls` if in
# doubt - don't assume a single suffix applies everywhere.
# (De-duplicated: the original config had this whole block repeated twice.)
PUWeightPath : "LUM/Run2-2018-UL-NanoAODv9/latest/puWeights.json.gz"
JERSFPath : "JME/Run2-2018-UL-NanoAODv15/latest/jet_jerc.json.gz"
JECPath : "JME/Run2-2018-UL-NanoAODv15/latest/jet_jerc.json.gz"
# CMS JME's official "JERSmear" correctionlib tool - SmearJER() uses this
# instead of an in-house TRandom3 implementation when set (see
# SSBCorrections.cpp). CORRECTION (2026-08, real run): jer_smear.json.gz was
# NOT actually found at this path on cvmfs ("Failed to open file") - left
# unset below so the code falls back to the in-house TRandom3 smearing
# (functional, just not the CMS-recommended method) instead of failing a
# pointless lookup every job. If you find the real path/filename (try
# `ls /cvmfs/cms-griddata.cern.ch/cat/metadata/JME/Run2-2018-UL-NanoAODv15/latest/`
# for anything jer/smear-related, or check if 2018 UL JMAR/JME simply doesn't
# have this file yet), uncomment and fix the path below.
JERSmearPath : "JME/JER-Smearing/latest/jer_smear.json.gz"
JERSmearName : "JERSmear"
#JESName : "Summer19UL16_V7_MC_L1L2L3Res_AK4PFchs" ## dead key, not read anywhere in SSBCorrections.cpp - left commented out
JERPath : "JME/Run2-2018-UL-NanoAODv15/latest/jet_jerc.json.gz"
# Confirmed by your own `ls /cvmfs/cms-griddata.cern.ch/cat/metadata/JME/Run2-2018-UL-NanoAODv9/latest/`:
# jmar.json.gz (PU jet ID SF) lives under the v9 folder, not v15 - same
# "not every POG got a new v15 folder" situation as LUM/MUO/EGM (see the
# PUWeightPath/MuonSFPath/ElecSFPath comment above). JME's OWN directory has
# both an old (v9) and new (v15) latest/ folder, and jmar.json.gz only exists
# in the old one - the new v15 JME folder only got jet_jerc.json.gz/
# jetvetomaps.json.gz/fatJet_jerc.json.gz/met.json.gz (the things that
# actually changed with Puppi jets), not jmar.json.gz.
JMARPath : "JME/Run2-2018-UL-NanoAODv9/latest/jmar.json.gz"
JetVetoPath : "JME/Run2-2018-UL-NanoAODv15/latest/jetvetomaps.json.gz"
JetVetoName : "Summer19UL18_V1" ## Confirmed present in your jetvetomaps.json.gz (single correction, inputs: type/eta/phi - matches ShouldVetoJet's evaluate() call)
JetVetoKey: "jetvetomap" # "jetvetomap, jetvetomap_hot, jetvetomap_all, jetvetomap_hem1516"
JetVetoType: "jet" # jet/event

## AK4 Puppi is the NanoAODv15 default Jet collection (was AK4PFchs in v9).
## These are read by ExpandJECName; leaving them unset falls back to the same
## Puppi-jet defaults ("AK4PFPuppi"/"L1L2L3Res") - set explicitly here for
## clarity and so this config is self-documenting.
JetAlgoTag : "AK4PFPuppi"
JECLevel : "L1L2L3Res"

## Confirmed directly from your jet_jerc.json.gz (79 corrections, 2 compound):
## compound "Summer20UL18NanoV15_V1_MC_L1L2L3Res_AK4PFPuppi" (inputs: JetA,
## JetEta, JetPt, Rho) and "..._V1_DATA_L1L2L3Res_AK4PFPuppi" (same + run) -
## exactly matches what ExpandJECName builds with JECName+JetAlgoTag+JECLevel
## below. No longer a guess.
#JECName : "Summer19UL18_V5_MC_L1L2L3Res_AK4PFchs" ## old v9/PFchs value, kept for reference
JECName : "Summer20UL18NanoV15_V1"
## Also confirmed from jet_jerc.json.gz - JER kept the OLD "Summer19UL18_JRV3"
## naming (not a new v15-style tag like the JEC got), just with _AK4PFPuppi
## instead of _AK4PFchs.
JERName : "Summer19UL18_JRV3_MC_ScaleFactor_AK4PFPuppi"
JERResName : "Summer19UL18_JRV3_MC_PtResolution_AK4PFPuppi"


MuonSFPath : "MUO/Run2-2018-UL-NanoAODv9/latest/muon_Z.json.gz"
MuonIDSFName : "NUM_TightID_DEN_TrackerMuons"
MuonIsoSFName : "NUM_TightRelIso_DEN_TightIDandIPCut"

ElecSFPath : "EGM/Run2-2018-UL-NanoAODv9/latest/electron.json.gz"
ElecIDSFName : "UL-Electron-ID-SF"

LepIDSFSys : "nominal"
LepIsoSFSys : "nominal"
LepRecoSFSys : "nominal"
LepTrackSFSys : "nominal" 
